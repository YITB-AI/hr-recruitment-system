# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hr-recruitment-system?retryWrites=true&w=majority"

# n8n Cloud webhook URLs, one per action (Applicant Quick Actions)
N8N_WEBHOOK_SEND_EMAIL=
N8N_WEBHOOK_SEND_SMS=
N8N_WEBHOOK_AI_CALL=
# Create Application modal (Applicants page) — receives {jobId, jobTitle,
# jobDescription, companyId, fileName, mimeType, fileBase64, ...}; the n8n
# workflow parses the CV and creates the Applicant record itself.
N8N_WEBHOOK_CREATE_APPLICATION=
# Account/transactional email (OTP verification codes, welcome emails on
# account creation) — receives {to, subject, html}; the n8n workflow should
# just send that email however you've configured it to (Gmail/Outlook/SMTP
# node, etc.) and return 200. See lib/email.ts.
N8N_WEBHOOK_SEND_ACCOUNT_EMAIL=

# Optional: sent as a header on every outgoing webhook request, if you've set
# up Header Auth on the n8n webhook trigger nodes. Leave both blank to skip.
N8N_WEBHOOK_AUTH_HEADER_NAME=
N8N_WEBHOOK_AUTH_HEADER_VALUE=

# Required for n8n to call BACK into this app (app/api/webhooks/ai-call) with
# AI call progress/outcome. Generate a long random value and configure your
# n8n HTTP Request node to send it as the X-Callback-Secret header.
N8N_WEBHOOK_CALLBACK_SECRET=

# Vercel Blob — stores uploaded document templates and generated documents
# (serverless functions have no persistent local disk). Enable Blob storage
# on your Vercel project (Storage tab) to get this automatically, or run
# `vercel env pull` to copy it into your local .env.local for dev/seeding.
BLOB_READ_WRITE_TOKEN=

# Random secret used to HMAC-hash OTP verification codes at rest (a 6-digit
# code has only 1,000,000 possible values, so an unkeyed hash would be
# trivially precomputable from a DB read alone). Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
OTP_HASH_SECRET=

# AES-256-GCM key (base64, must decode to exactly 32 bytes) used by
# lib/crypto.ts to encrypt sensitive fields at rest — per-company n8n/SMTP/
# social-media credentials (CompanyIntegrationConfig) and calendar OAuth
# tokens (CalendarConnection). Generate with `openssl rand -base64 32`.
# Required before those features can save or read any encrypted field. No
# key-rotation tooling exists yet — changing this after secrets have been
# saved makes them undecryptable; see lib/crypto.ts's header comment.
CONFIG_ENCRYPTION_KEY=

# This app's own public URL, with no trailing slash — used to build OAuth
# redirect URIs (Google/Microsoft/Facebook/X calendar and social-media
# connect flows) and the public Indeed job-feed URL shown in Company
# Configuration. Set to your real production URL when deployed.
APP_BASE_URL=http://localhost:3000

# Google Calendar integration (Profile > Calendar) — create an OAuth 2.0
# Client (Web application) in Google Cloud Console, enable the Google
# Calendar API, and register this exact redirect URI:
#   ${APP_BASE_URL}/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Outlook/Microsoft Calendar integration — register an app in Azure AD
# (Entra ID) > App registrations, add redirect URI (Web):
#   ${APP_BASE_URL}/api/calendar/outlook/callback
# and grant delegated Microsoft Graph permissions: Calendars.ReadWrite,
# offline_access, User.Read.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# "common" allows both personal and work/school Microsoft accounts to
# connect; set to your own Azure AD tenant ID to restrict to just your org.
MICROSOFT_TENANT_ID=common

# Cloudflare Turnstile CAPTCHA on the login form. Create a free Cloudflare
# account, add a Turnstile widget for your domain (dash.cloudflare.com >
# Turnstile), and set both keys below. NEXT_PUBLIC_TURNSTILE_SITE_KEY is
# safe to expose client-side (that's its whole purpose); leave both blank
# to skip CAPTCHA entirely — login still works normally either way, see
# lib/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
